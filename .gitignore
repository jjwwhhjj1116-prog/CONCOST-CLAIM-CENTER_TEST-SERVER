# Node.js
node_modules/
.pnpm-store/
dist/
.next/
out/
build/
*.tsbuildinfo

# Logs & Evidence outputs that shouldn't be tracked in source control if temporary
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Preserve harness evidence logs
!artifacts/harness/**/*.log

# Exclude external reviewer files from implementation commits
docs/reviews/P*-codex-review.md
docs/reviews/P*-codex-review.json

# Reference Report Templates Original Storage (Git exclusion for customer privacy)
/docs/보고서 템플릿/**
!/docs/보고서 템플릿/README.md
!/docs/보고서 템플릿/.gitkeep
/docs/클레임 업무 프로세스.xlsx
/local-reference/**

# Database Local SQLite Files
.data/
*.db
*.db-journal
*.db-shm
*.db-wal

# Environment & Secrets (CRITICAL SECURITY)
.env
.env*.local
.env.production
.env.development
.env.cloudflare.shared.local
*.pem
*.key
credentials.json
*.vietnam-env.enc.json

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Test Coverage
coverage/
.nyc_output/

# Cloudflare Wrangler local emulator state
.wrangler/
