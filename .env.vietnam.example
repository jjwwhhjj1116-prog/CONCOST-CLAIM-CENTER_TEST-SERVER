# Copy to .env.vietnam.local. Never commit the .local file.
NODE_ENV=production
PORT=8080
CLAIM_VOLUME_ROOT=/srv/concost-claim-center
DATABASE_URL=file:/srv/concost-claim-center/database/claim-center.db
CLAIM_ALLOWED_ORIGINS=https://claimcenterstudio.con-cost.co.kr

# References keep secret names separate from configuration names.
CLAIM_BACKUP_SIGNING_KEY_REF=ENV_CLAIM_BACKUP_SIGNING_KEY
CLAIM_BACKUP_SIGNING_KEY=
GOOGLE_WORKSPACE_CREDENTIAL_MASTER_KEY_REF=ENV_GOOGLE_WORKSPACE_CREDENTIAL_MASTER_KEY
GOOGLE_WORKSPACE_CREDENTIAL_MASTER_KEY=
AI_CREDENTIAL_MASTER_KEY_REF=ENV_AI_CREDENTIAL_MASTER_KEY
AI_CREDENTIAL_MASTER_KEY=

# Google Workspace real provider.
GOOGLE_WORKSPACE_PROVIDER_MODE=REAL
GOOGLE_WORKSPACE_CLIENT_ID_REF=ENV_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET_REF=ENV_GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REDIRECT_URI=https://claimcenterstudio.con-cost.co.kr/api/google/oauth/callback
GOOGLE_WORKSPACE_REDIRECT_ORIGINS=https://claimcenterstudio.con-cost.co.kr
GOOGLE_ALLOWED_DOMAIN=con-cost.com
GOOGLE_ALLOWED_ACCOUNT=concost.dt@gmail.com

# AI providers and model governance.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
GEMINI_API_KEY=
GEMINI_DATA_GOVERNANCE_MODE=PAID
LAW_API_OC=

# Collaboration, memory and ERP integrations (fill when enabled).
COLLABORATION_JWT_SECRET=
MEMORY_SERVICE_URL=
MEMORY_BRIDGE_HMAC_KEY=
ERP_PROJECT_WEBHOOK_URL=
ERP_PROJECT_WEBHOOK_SECRET=
