generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../.data/dev.db"
}

model Organization {
  id                         String                      @id
  name                       String
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  users                      User[]
  cases                      CaseItem[]
  auditLogs                  AuditLog[]
  reportTemplates            ReportTemplate[]
  reportInstances            ReportInstance[]
  aiProviderConfigs          AiProviderConfig[]
  aiUsageLedgers             AiUsageLedger[]
  aiGenerationRequests       AiGenerationRequest[]
  groundingSelections        AiGroundingSelection[]
  draftSuggestions           AiDraftSuggestion[]
  reportReviewRequests       ReportReviewRequest[]
  reportFinalizations        ReportFinalization[]
  reportOutputArtifacts      ReportOutputArtifact[]
  reportOutputDownloads      ReportOutputDownload[]
  feeConfigs                 CaseFeeConfig[]
  feeCalculations            CaseFeeCalculation[]
  feePayments                CaseFeePayment[]
  feeAudits                  CaseFeeAudit[]
  googleWorkspaceConnections GoogleWorkspaceConnection[]
  googleOAuthStates          GoogleOAuthState[]
  googleSyncOperations       GoogleSyncOperation[]
  googleResourceLinks        GoogleResourceLink[]
  googleImportSnapshots      GoogleImportSnapshot[]
  userRegistrationRequests   UserRegistrationRequest[]
  businessCards              BusinessCard[]
  businessCardAnalyses       BusinessCardAnalysis[]
  businessCardOperations     BusinessCardOperation[]
  businessCardEvents         BusinessCardEvent[]
}

model User {
  id                              String                        @id
  email                           String                        @unique
  passwordHash                    String
  name                            String
  organizationId                  String
  isActive                        Boolean                       @default(true)
  createdAt                       DateTime                      @default(now())
  updatedAt                       DateTime                      @updatedAt
  organization                    Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles                           UserRole[]
  sessions                        Session[]
  assignments                     CaseAssignment[]
  assignedCases                   CaseItem[]                    @relation("AssignedCases")
  statusHistories                 StatusHistory[]
  auditLogs                       AuditLog[]
  uploadedVersions                DocumentVersion[]
  createdMeetings                 Meeting[]
  actionItems                     MeetingActionItem[]
  createdProposals                Proposal[]                    @relation("ProposalCreator")
  updatedProposals                Proposal[]                    @relation("ProposalUpdater")
  createdProposalVersions         ProposalVersion[]             @relation("ProposalVersionCreator")
  proposalReviews                 ProposalReview[]
  createdReportTemplates          ReportTemplate[]              @relation("ReportTemplateCreator")
  createdReportTemplateVersions   ReportTemplateVersion[]       @relation("ReportTemplateVersionCreator")
  approvedReportTemplateVersions  ReportTemplateVersion[]       @relation("ReportTemplateVersionApprover")
  createdReportInstances          ReportInstance[]              @relation("ReportInstanceCreator")
  createdSectionRevisions         ReportSectionRevision[]       @relation("SectionRevisionAuthor")
  createdSectionComments          ReportSectionComment[]        @relation("SectionCommentAuthor")
  resolvedSectionComments         ReportSectionComment[]        @relation("SectionCommentResolver")
  approvedReportSections          ReportSectionApproval[]       @relation("SectionApprovalApprover")
  createdReportMergeSnapshots     ReportMergeSnapshot[]         @relation("ReportMergeSnapshotCreator")
  aiUsageLedgers                  AiUsageLedger[]
  aiGenerationRequests            AiGenerationRequest[]
  groundingSelections             AiGroundingSelection[]
  createdSuggestions              AiDraftSuggestion[]           @relation("SuggestionActor")
  appliedSuggestions              AiDraftSuggestion[]           @relation("SuggestionAppliedActor")
  requestedReportReviews          ReportReviewRequest[]         @relation("ReportReviewRequestedBy")
  assignedReportReviews           ReportReviewRequest[]         @relation("ReportReviewAssignedReviewer")
  finalizedReports                ReportFinalization[]          @relation("ReportFinalizedBy")
  approvedFinalizationSections    ReportFinalizationSection[]   @relation("FinalizationSectionApprovedBy")
  downloadedReportOutputs         ReportOutputDownload[]        @relation("ReportOutputDownloadedBy")
  feeCalculations                 CaseFeeCalculation[]          @relation("FeeCalculatedBy")
  feePayments                     CaseFeePayment[]              @relation("FeePaymentRecordedBy")
  feeAudits                       CaseFeeAudit[]                @relation("FeeAuditActor")
  createdGoogleConnections        GoogleWorkspaceConnection[]   @relation("GoogleConnectionCreatedBy")
  googleOAuthStates               GoogleOAuthState[]            @relation("GoogleOAuthActor")
  createdGoogleSyncOps            GoogleSyncOperation[]         @relation("GoogleSyncOpActor")
  createdGoogleSnapshots          GoogleImportSnapshot[]        @relation("GoogleSnapshotCreatedBy")
  reviewedRegistrationRequests    UserRegistrationRequest[]     @relation("RegistrationReviewedBy")
  assignedReportSections          ReportSectionAssignment[]     @relation("ReportSectionAssignee")
  createdReportSectionAssignments ReportSectionAssignment[]     @relation("ReportSectionAssignedBy")
  updatedCaseScheduleVisibilities CaseScheduleVisibility[]      @relation("CaseScheduleVisibilityUpdatedBy")
  caseScheduleVisibilityEvents    CaseScheduleVisibilityEvent[] @relation("CaseScheduleVisibilityEventActor")
  createdBusinessCards            BusinessCard[]                @relation("BusinessCardCreatedBy")
  businessCardAnalyses            BusinessCardAnalysis[]        @relation("BusinessCardAnalysisCreatedBy")
  updatedBusinessCards            BusinessCard[]                @relation("BusinessCardUpdatedBy")
  archivedBusinessCards           BusinessCard[]                @relation("BusinessCardDeletedBy")
  createdBusinessCardOperations   BusinessCardOperation[]       @relation("BusinessCardOperationCreatedBy")
  businessCardEvents              BusinessCardEvent[]           @relation("BusinessCardEventActor")
}

model UserRegistrationRequest {
  id             String       @id
  organizationId String
  loginId        String
  displayName    String
  email          String
  passwordHash   String
  requestedRole  String       @default("staff")
  requestNote    String?
  status         String       @default("PENDING")
  reviewNote     String?
  reviewedById   String?
  reviewedAt     DateTime?
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reviewedBy     User?        @relation("RegistrationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
}

model Role {
  id    String     @id
  name  String     @unique
  users UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
}

model Session {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CaseItem {
  id                       String                        @id
  organizationId           String
  caseNumber               String                        @unique
  title                    String
  description              String?
  claimType                String
  status                   String                        @default("INQUIRY")
  assignedUserId           String?
  version                  Int                           @default(1)
  deletedAt                DateTime?
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  organization             Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignedUser             User?                         @relation("AssignedCases", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignments              CaseAssignment[]
  category                 CaseCategory?
  parties                  Party[]
  schedules                Schedule[]
  statusHistories          StatusHistory[]
  reports                  Report[]
  documents                Document[]
  meetings                 Meeting[]
  proposals                Proposal[]
  reportInstances          ReportInstance[]
  aiPolicy                 AiCasePolicy?
  aiUsageLedgers           AiUsageLedger[]
  aiGenerationRequests     AiGenerationRequest[]
  groundingSelections      AiGroundingSelection[]
  reviewRequests           ReportReviewRequest[]
  finalizations            ReportFinalization[]
  outputArtifacts          ReportOutputArtifact[]
  downloadedReportOutputs  ReportOutputDownload[]
  draftSuggestions         AiDraftSuggestion[]
  feeConfig                CaseFeeConfig?
  feeCalculations          CaseFeeCalculation[]
  feePayments              CaseFeePayment[]
  feeAudits                CaseFeeAudit[]
  googleSyncOperations     GoogleSyncOperation[]
  googleResourceLinks      GoogleResourceLink[]
  googleImportSnapshots    GoogleImportSnapshot[]
  scheduleVisibility       CaseScheduleVisibility?
  scheduleVisibilityEvents CaseScheduleVisibilityEvent[]

  @@index([organizationId, deletedAt])
  @@index([caseNumber])
  @@index([status])
}

model CaseCategory {
  id        String   @id
  caseId    String   @unique
  major     String
  middle    String
  minor     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  case      CaseItem @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([major, middle, minor])
}

model CaseAssignment {
  caseId String
  userId String
  case   CaseItem @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([caseId, userId])
}

model Party {
  id        String   @id
  caseId    String
  name      String
  role      String
  contact   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  case      CaseItem @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([name])
}

model Schedule {
  id          String              @id
  caseId      String
  title       String
  type        String
  date        DateTime
  location    String?
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  case        CaseItem            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actionItems MeetingActionItem[]
  documents   Document[]

  @@index([caseId])
  @@index([date])
  @@index([type])
}

model StatusHistory {
  id          String   @id
  caseId      String
  fromStatus  String?
  toStatus    String
  changedById String
  reason      String?
  createdAt   DateTime @default(now())
  case        CaseItem @relation(fields: [caseId], references: [id], onDelete: Cascade)
  changedBy   User     @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
}

model Document {
  id                String            @id
  caseId            String
  scheduleId        String?
  reportSectionId   String?
  proposalVersionId String?
  title             String
  category          String?
  source            String // RECEIVED, AUTHORED, SUBMITTED
  currentVersionId  String?
  finalVersionId    String?
  version           Int               @default(1)
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  case              CaseItem          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  schedule          Schedule?         @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  reportSection     ReportSection?    @relation(fields: [reportSectionId], references: [id], onDelete: SetNull)
  proposalVersion   ProposalVersion?  @relation(fields: [proposalVersionId], references: [id], onDelete: Restrict)
  versions          DocumentVersion[]

  @@index([caseId, deletedAt])
  @@index([scheduleId])
  @@index([reportSectionId])
  @@index([proposalVersionId])
  @@index([source])
}

model DocumentVersion {
  id              String                 @id
  documentId      String
  versionNumber   Int
  originalName    String
  displayName     String
  storageKey      String                 @unique
  fileSize        Int
  mimeType        String
  sha256          String
  isFinal         Boolean                @default(false)
  uploadedById    String
  createdAt       DateTime               @default(now())
  document        Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy      User                   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  evidenceLinks   ReportEvidenceLink[]
  outputArtifacts ReportOutputArtifact[]
  evidenceVersion EvidenceVersion?

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([storageKey])
}

// CF104 SQLite handoff schema. The legacy Node /documents API is not the Cloudflare /evidence adapter.
model EvidenceVersion {
  id String @id
  organizationId String
  caseId String
  category String
  documentVersionId String? @unique
  groupId String
  versionNumber Int
  isLatest Boolean @default(true)
  supersedesId String? @unique
  changeSummaryJson String @default("[]")
  modelCode String @default("")
  documentVersion DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  @@unique([groupId, versionNumber])
  @@index([organizationId, caseId, category, isLatest])
}

model EvidenceUploadReview {
  id String @id
  organizationId String
  caseId String
  category String
  userId String
  fingerprint String
  baseId String
  snapshotHash String
  analysisJson String
  modelCode String
  expiresAt DateTime
  consumedAt DateTime?
}

model EvidenceUploadLock {
  organizationId String
  caseId String
  category String
  id String @unique
  userId String
  createdAt DateTime @default(now())
  @@id([organizationId, caseId, category])
}

model Meeting {
  id            String               @id
  caseId        String
  title         String
  meetingDate   DateTime
  location      String?
  attendees     String?
  rawText       String?
  rawTextSha256 String?
  summary       String?
  decisions     String?
  status        String               @default("DRAFT") // DRAFT, FINAL
  version       Int                  @default(1)
  createdById   String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  case          CaseItem             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy     User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  actionItems   MeetingActionItem[]
  evidenceLinks ReportEvidenceLink[]

  @@index([caseId])
  @@index([meetingDate])
  @@index([status])
}

model MeetingActionItem {
  id         String    @id
  meetingId  String
  title      String
  assigneeId String?
  scheduleId String?
  dueDate    DateTime?
  status     String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  meeting    Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignee   User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([assigneeId])
  @@index([scheduleId])
}

model Report {
  id                  String                 @id
  caseId              String
  reportInstanceId    String?                @unique
  title               String
  version             Int                    @default(1)
  deletedAt           DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  case                CaseItem               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reportInstance      ReportInstance?        @relation(fields: [reportInstanceId], references: [id], onDelete: Restrict)
  sections            ReportSection[]
  mergeSnapshots      ReportMergeSnapshot[]
  groundingSelections AiGroundingSelection[]
  draftSuggestions    AiDraftSuggestion[]
  reviewRequests      ReportReviewRequest[]
  finalizations       ReportFinalization[]
  outputArtifacts     ReportOutputArtifact[]

  @@index([caseId, deletedAt])
}

model ReportSection {
  id                        String                      @id
  reportId                  String
  templateSectionIdSnapshot String?
  sectionNumber             Int                         @default(1)
  title                     String
  content                   String
  status                    String
  isRequired                Boolean                     @default(false)
  blockSchemaSnapshotJson   String                      @default("{}")
  version                   Int                         @default(1)
  deletedAt                 DateTime?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  report                    Report                      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  documents                 Document[]
  revisions                 ReportSectionRevision[]
  comments                  ReportSectionComment[]
  approvals                 ReportSectionApproval[]
  groundingSelections       AiGroundingSelection[]
  draftSuggestions          AiDraftSuggestion[]
  finalizationSections      ReportFinalizationSection[]
  assignment                ReportSectionAssignment?

  @@index([reportId, deletedAt])
}

model ReportSectionAssignment {
  sectionId    String        @id
  assigneeId   String
  assignedById String
  status       String        @default("IN_PROGRESS")
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  section      ReportSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  assignee     User          @relation("ReportSectionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedBy   User          @relation("ReportSectionAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([assigneeId, status, updatedAt])
}

model CaseScheduleVisibility {
  caseId           String   @id
  organizationId   String
  visibility       String   @default("ACTIVE")
  reasonCode       String?
  reasonText       String?
  driveVerified    Boolean  @default(false)
  manifestSha256   String?
  verificationJson String   @default("{}")
  version          Int      @default(1)
  updatedById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  case             CaseItem @relation(fields: [caseId], references: [id], onDelete: Restrict)
  updatedBy        User     @relation("CaseScheduleVisibilityUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([organizationId, visibility, updatedAt])
}

model CaseScheduleVisibilityEvent {
  id               String   @id
  caseId           String
  organizationId   String
  fromVisibility   String
  toVisibility     String
  reasonCode       String
  reasonText       String
  driveVerified    Boolean
  manifestSha256   String?
  verificationJson String
  actorId          String
  createdAt        DateTime @default(now())
  case             CaseItem @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actor            User     @relation("CaseScheduleVisibilityEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
}

model BusinessCardOperation {
  id                 String       @id
  organizationId     String
  idempotencyKey     String
  requestFingerprint String
  status             String       @default("PENDING")
  cardId             String?
  googleFileId       String?
  errorCode          String?
  createdById        String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy          User         @relation("BusinessCardOperationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, updatedAt])
}

model BusinessCardAnalysis {
  id                     String        @id
  organizationId         String
  originalName           String
  mimeType               String
  byteSize               Int
  sourceSha256           String
  geminiModelCode        String
  geminiCredentialSource String
  extractedJson          String
  createdById            String
  createdAt              DateTime      @default(now())
  expiresAt              DateTime
  consumedAt             DateTime?
  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy              User          @relation("BusinessCardAnalysisCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  card                   BusinessCard?

  @@index([createdById, expiresAt, consumedAt])
}

model BusinessCard {
  id                     String               @id
  organizationId         String
  analysisId             String               @unique
  name                   String
  company                String?
  department             String?
  title                  String?
  mobile                 String?
  phone                  String?
  fax                    String?
  email                  String?
  address                String?
  website                String?
  notes                  String?
  tagsText               String?
  originalName           String
  mimeType               String
  byteSize               Int
  sourceSha256           String
  googleFileId           String
  googleFolderId         String
  googleDriveUrl         String
  geminiModelCode        String
  geminiCredentialSource String
  extractedJson          String
  reviewConfirmed        Boolean              @default(true)
  version                Int                  @default(1)
  createdById            String
  updatedById            String
  deletedById            String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  analysis               BusinessCardAnalysis @relation(fields: [analysisId], references: [id], onDelete: Restrict)
  createdBy              User                 @relation("BusinessCardCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy              User                 @relation("BusinessCardUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedBy              User?                @relation("BusinessCardDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  events                 BusinessCardEvent[]

  @@index([organizationId, deletedAt, name, company, department])
  @@index([createdById, createdAt])
  @@index([organizationId, sourceSha256, deletedAt])
}

model BusinessCardEvent {
  id             String       @id
  organizationId String
  cardId         String
  eventType      String
  detailJson     String
  actorId        String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  card           BusinessCard @relation(fields: [cardId], references: [id], onDelete: Restrict)
  actor          User         @relation("BusinessCardEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([cardId, createdAt])
}

model ProposalTemplate {
  id               String     @id
  name             String
  claimType        String // TYPE-01 to TYPE-06
  description      String?
  bodyTemplate     String
  placeholdersJson String
  version          Int        @default(1)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  proposals        Proposal[]

  @@index([claimType])
}

model Proposal {
  id                               String            @id
  caseId                           String
  templateId                       String
  templateVersionSnapshot          Int
  templateBodySnapshot             String
  templatePlaceholdersSnapshotJson String
  title                            String
  status                           String            @default("DRAFT") // DRAFT, IN_REVIEW, APPROVED, REJECTED
  currentVersionId                 String?
  approvedVersionId                String?
  outputDocumentId                 String?
  version                          Int               @default(1)
  createdById                      String
  updatedById                      String
  deletedAt                        DateTime?
  createdAt                        DateTime          @default(now())
  updatedAt                        DateTime          @updatedAt
  case                             CaseItem          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  template                         ProposalTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdBy                        User              @relation("ProposalCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                        User              @relation("ProposalUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  versions                         ProposalVersion[]
  reviews                          ProposalReview[]

  @@index([caseId, deletedAt])
  @@index([templateId])
  @@index([updatedById])
  @@index([status])
}

model ProposalVersion {
  id                           String           @id
  proposalId                   String
  versionNumber                Int
  bodyText                     String
  structuredInputsJson         String
  renderedValuesJson           String
  missingFieldsJson            String
  generationMode               String // MANUAL, AI
  providerId                   String?
  modelId                      String?
  promptConfigVersion          String?
  inputSha256                  String
  generatedAt                  DateTime?
  sourceDocumentVersionIdsJson String?
  sha256                       String
  isApproved                   Boolean          @default(false)
  createdById                  String
  createdAt                    DateTime         @default(now())
  proposal                     Proposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  createdBy                    User             @relation("ProposalVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviews                      ProposalReview[]
  outputDocuments              Document[]

  @@unique([proposalId, versionNumber])
  @@index([proposalId])
}

model ProposalReview {
  id         String          @id
  proposalId String
  versionId  String
  reviewerId String
  action     String // REQUEST_REVIEW, APPROVE, REJECT
  comment    String?
  createdAt  DateTime        @default(now())
  proposal   Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  version    ProposalVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  reviewer   User            @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([proposalId])
  @@index([versionId])
  @@index([reviewerId])
}

model ReferenceInventory {
  id                 String              @id
  fileId             String              @unique
  sha256             String
  fileSize           Int
  scanStatus         String              @default("UNSCANNED")
  approvalStatus     String              @default("REVIEW_REQUIRED")
  version            Int                 @default(1)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  templateReferences TemplateReference[]

  @@index([approvalStatus])
}

model ReportTemplate {
  id             String                  @id
  organizationId String
  code           String
  name           String
  description    String?
  status         String                  @default("ACTIVE")
  version        Int                     @default(1)
  createdById    String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      User                    @relation("ReportTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions       ReportTemplateVersion[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model ReportTemplateVersion {
  id                        String                @id
  templateId                String
  versionNumber             Int
  rowVersion                Int                   @default(1)
  name                      String
  companyForm               String
  tocStructureJson          String
  requiredSectionsJson      String
  requiredEvidenceRulesJson String
  blockSchemasJson          String
  contentSha256             String
  status                    String                @default("DRAFT")
  createdById               String
  approvedById              String?
  approvedAt                DateTime?
  activatedAt               DateTime?
  archivedAt                DateTime?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  template                  ReportTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdBy                 User                  @relation("ReportTemplateVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy                User?                 @relation("ReportTemplateVersionApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  typeMappings              TemplateTypeMapping[]
  sections                  TemplateSection[]
  references                TemplateReference[]
  reportInstances           ReportInstance[]
