{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "concost-claim-center-development",
  "main": "apps/cloudflare/src/index.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "concost-claim-center-development-db",
      "database_id": "16d1f25b-60c8-4489-95ed-4fa7de161c9f",
      "migrations_dir": "apps/cloudflare/migrations"
    }
  ],
  "compatibility_date": "2026-08-11",
  "placement": {
    "region": "gcp:asia-northeast3"
  },
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.jpg"],
      "fallthrough": true
    }
  ],
  "vars": {
    "GOOGLE_ALLOWED_DOMAIN": "con-cost.com",
    "GOOGLE_ALLOWED_ACCOUNT": "concost.dt@gmail.com",
    "GOOGLE_OAUTH_REDIRECT_ORIGIN": "https://concost-claim-center-development.jjwwhhjj1116.workers.dev"
  },
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/health", "/readiness"]
  },
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": ["GOOGLE_WORKSPACE_CREDENTIAL_MASTER_KEY"]
  }
}
