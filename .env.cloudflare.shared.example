# Copy this file to .env.cloudflare.shared.local and fill it once.
# Never commit the .local file. The sync command never prints these values.

# Encryption master keys are intentionally excluded from routine bulk sync.
# Replacing them without re-encrypting D1 credentials makes saved Google/AI
# credentials unreadable. Preserve them in the Cloudflare secret vault.

# Optional environment fallbacks. Admin-saved D1 credentials remain environment-specific.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
GEMINI_API_KEY=

# Optional Google OAuth application fallback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional integrations shared by both environments when enabled.
LAW_API_OC=
PM_NOTIFICATION_WEBHOOK_URL=
PM_NOTIFICATION_WEBHOOK_SECRET=
ERP_PROJECT_WEBHOOK_URL=
ERP_PROJECT_WEBHOOK_SECRET=
